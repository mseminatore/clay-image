// clay-image -- TODO: what this brick does, in one line
//
// Usage:
//   import("clay-image")
//
//   c = ClayImage counter(10)
//   c add(5)
//   c value println          // 15
//
// How it fits together: `ClayImage` (below) is Clay and only makes counters. Each
// counter is a clone of `ClayImageCore`, the prototype the C plugin registers
// (native/clay_image.c), so its methods are written in C. Put the friendly API
// here and the heavy work in C.
//
// Every brick shares one set of top-level names with the program that imports
// it, so keep yours few and distinctive.

ClayImage = Object clone {
    counter(start = 0) { ClayImageCore create(start) }
}
