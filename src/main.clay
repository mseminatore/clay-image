// Image -- reads, writes and converts images (stb_image underneath)
//
// Usage:
//   import("image")
//
//   img = Image load(path)              // a new image from a file
//   img = Image fromBytes(w, h, c, bytes)     // from pixel bytes
//   img = Image fromFloats(w, h, c, numbers)  // from numbers in 0..1
//                                             // (clamped), e.g. a spectrogram
//
//   img width, img height    // size in pixels
//   img channels             // 1 gray, 2 gray+alpha, 3 RGB, 4 RGBA
//   img pixels               // a String of width * height * channels bytes
//   img floats               // a flat Array of numbers in 0..1, e.g. NN input
//   img savePng(path)        // saves as PNG
//   img info                 // prints size and channels
//
// Pixel data is row by row, top to bottom, channels interleaved.
//
// How it fits together: `ImageCore` is the prototype the C plugin registers
// (native/image.c), and `Image` is a clone of it, so every image has its C
// methods. The C methods named with a leading `_` are internal: the
// constructors below use them. Images don't change once made; to work on
// another file, make another image (`img = Image load(other)`).
//
// Every brick shares one set of top-level names with the program that imports
// it, so keep yours few and distinctive.

Image = ImageCore clone {
    load(path) { self _blank _read(path) }
    fromBytes(w, h, c, bytes) { self _blank _setPixels(w, h, c, bytes) }
    fromFloats(w, h, c, numbers) { self _blank _setFloats(w, h, c, numbers) }

    // A new, empty image for a constructor to fill. Constructors are sent to
    // Image itself: sent to an image (`img load(path)`), they would make a new
    // image and leave img as it was, which is never what was meant.
    _blank() {
        (self == Image) ifFalse {
            raise("Image: make images with Image load, fromBytes or fromFloats; images don't change once made")
        }
        Image _create
    }
}
