// Tests for the clay-image brick. Run them from the brick's directory:
//   clay tests/test_clay_image.clay
// The first run builds the C plugin (into build/, which is not committed); a
// brick can be imported by its own name from inside its own directory.
import("clay-image")

failures = 0
check = { |what, ok|
    ok ifFalse { ("FAIL: " + what) println; failures = failures + 1 }
}
raises = { |block| try { block value; "no error" } catch { |e| e type } }

c = ClayImage counter(10)
check value("start", c value == 10)
c add(5)
check value("add", c value == 15)
check value("add chains", ((c add(1)) add(2)) value == 18)
check value("default start", (ClayImage counter) value == 0)

d = ClayImage counter(1)
d add(1)
check value("counters are independent", ((c value) == 18) && ((d value) == 2))

check value("a bad argument raises", (raises value({ c add("x") })) == "ArgumentError")

(failures > 0) ifTrue {
    (failures toString + " checks failed") println
    System exit(1)
}
"clay-image tests passed" println
