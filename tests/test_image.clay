// Tests for the image brick. Run them from the brick's directory:
//   clay tests/test_image.clay
// The first run builds the C plugin (into build/, which is not committed); a
// brick can be imported by its own name from inside its own directory.
//
// The tests need no image files: they make images with known pixels, and write
// files only to a temporary directory, which they remove.
import("image")

failures = 0

check = { |what, ok|
    ok ifFalse { ("FAIL: " + what) println; failures = failures + 1 }
}

raises = { |block| try { block value; "no error" } catch { |e| e type } }

dir = File tempDir
out = dir + "/out.png"
ext = dir + "/external.png"

// an image whose every byte is known: 16 x 8 RGBA
w = 16
h = 8
known = (0..((w * h * 4) - 1)) map { |i| ((i * 7) + 3) % 256 }
img = Image fromBytes(w, h, 4, String fromBytes(known))
check("width", img width == w)
check("height", img height == h)
check("channels", img channels == 4)
check("pixels", img pixels bytes == known)
check("images are Images", img parent == Image)
check("type", (img type == "Image") && (Image type == "Image"))

// round trip through a PNG file, with every channel count
img savePng(out)
copy = Image load(out)
check("round trip size", (copy width == w) && (copy height == h) && (copy channels == 4))
check("round trip pixels", copy pixels == img pixels)
(1..3) each { |c|
    bytes = String fromBytes(known slice(0, w * h * c))
    Image fromBytes(w, h, c, bytes) savePng(out)
    back = Image load(out)
    check("round trip with " + c toString + " channels", (back channels == c) && (back pixels == bytes))
}

// a PNG stb didn't write: 3 x 2 RGB, rows filtered None and Up, zlib level 9
File write(ext, String fromBytes([137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82,
    0, 0, 0, 3, 0, 0, 0, 2, 8, 2, 0, 0, 0, 18, 22, 241, 77, 0, 0, 0, 24, 73, 68, 65, 84, 120,
    218, 99, 248, 207, 192, 192, 0, 198, 76, 220, 34, 114, 26, 198, 54, 191, 26, 152, 0, 53,
    159, 5, 80, 110, 110, 6, 210, 0, 0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130]))
other = Image load(ext)
check("external PNG size", (other width == 3) && (other height == 2) && (other channels == 3))
check("external PNG pixels", other pixels bytes == [255, 0, 0, 0, 255, 0, 0, 0, 255, 10, 20, 30, 40, 50, 60, 250, 128, 1])

// Clay methods added to Image reach every image
Image setMethod("area", { self width * self height })
check("Clay methods on images", img area == (w * h))

// raw pixels
check("pixels length", img pixels length == (w * h * 4))
check("fromBytes keeps pixels", (Image fromBytes(w, h, 4, img pixels)) pixels == img pixels)
check("fromBytes takes any shape", (Image fromBytes(2, 1, 1, String fromBytes([7, 200]))) pixels bytes == [7, 200])

// floats
f = img floats
check("floats length", f size == (w * h * 4))
check("floats are bytes / 255", ((f at(0)) == (3 / 255.0)) && ((f at(5)) == (38 / 255.0)))
check("floats in 0..1", (f min >= 0) && (f max <= 1))
check("floats round trip", (Image fromFloats(w, h, 4, f)) pixels == img pixels)
gray = Image fromFloats(3, 2, 1, [0, 0.5, 1, 2, -1, 0.25])
check("fromFloats clamps and rounds", gray pixels bytes == [0, 128, 255, 255, 0, 64])
check("fromFloats takes rows", (Image fromFloats(3, 2, 1, [[0, 0.5, 1], [2, -1, 0.25]])) pixels == gray pixels)

// errors
check("missing file raises", (raises value({ Image load(dir + "/no-such-file.png") })) == "RuntimeError")
check("bad path raises", (raises value({ Image load(42) })) == "ArgumentError")
check("load on an image raises", (raises value({ img load(out) })) == "RuntimeError")
check("fromBytes on an image raises", (raises value({ img fromBytes(1, 1, 1, "a") })) == "RuntimeError")
check("fromFloats on an image raises", (raises value({ img fromFloats(1, 1, 1, [0]) })) == "RuntimeError")
check("the image is unchanged after", (img width == w) && (img pixels bytes == known))
check("wrong byte count raises", (raises value({ Image fromBytes(2, 2, 1, "abc") })) == "ArgumentError")
check("wrong number count raises", (raises value({ Image fromFloats(2, 2, 1, [0, 1]) })) == "ArgumentError")
check("bad channels raises", (raises value({ Image fromFloats(1, 1, 5, [0, 0, 0, 0, 0]) })) == "ArgumentError")
check("zero width raises", (raises value({ Image fromBytes(0, 1, 1, "") })) == "ArgumentError")
check("non-number raises", (raises value({ Image fromFloats(1, 1, 1, ["x"]) })) == "TypeError")

// the C layer
check("failed _read keeps the image", ((raises value({ img _read(dir + "/no-such-file.png") })) == "RuntimeError") && (img width == w) && (img channels == 4))
check("saving an empty image raises", (raises value({ ImageCore _create savePng(out) })) == "RuntimeError")
check("pixels of an empty image raises", (raises value({ ImageCore _create pixels })) == "RuntimeError")
check("bare prototype raises", (raises value({ ImageCore width })) == "RuntimeError")
check("bare Image raises", (raises value({ Image width })) == "RuntimeError")

File delete(out)
File delete(ext)
File delete(dir)

// Did we pass all tests?!
(failures > 0) ifTrue {
    (failures toString + " checks failed") println
    System exit(1)
}

// We did!
"image tests passed" println
